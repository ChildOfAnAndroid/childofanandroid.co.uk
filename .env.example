# Local frontend proxy. Remote targets additionally require explicit opt-in.
BBY_DEV_API_TARGET=http://127.0.0.1:8420
BBY_ALLOW_REMOTE_DEV_API=0

# Export these separately to the local Python gateway; it does not load .env.
LLM_SERVER_URL=http://127.0.0.1:4420
BBY_PORT=8420
BBY_ALLOWED_ORIGINS=http://127.0.0.1:6969,http://localhost:6969
# Leave blank to disable privileged operations until independently generated
# secrets have been configured. Never use VITE_* variables for these values.
BBY_ADMIN_TOKEN=
BBY_INTERNAL_TOKEN=
