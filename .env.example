# Frontend development only. Requests use /api on the current site origin.
BBY_DEV_API_TARGET=http://127.0.0.1:8420
# Remote backends are deliberately opt-in. Leave this at 0 for local work.
BBY_DEV_ALLOW_REMOTE=0

# Backend variables must be exported in the server process environment, not
# VITE_* variables or frontend bundles. Vite's .env file does not configure Flask.
# LLM_SERVER_URL=http://127.0.0.1:4420
# BBY_HOST=127.0.0.1
# BBY_ALLOWED_ORIGINS=https://childofanandroid.co.uk,https://www.childofanandroid.co.uk,http://localhost:6969,http://127.0.0.1:6969
# GALLERY_ADMIN_TOKEN=<use the existing private deployment secret>
